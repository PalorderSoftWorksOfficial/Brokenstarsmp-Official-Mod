package com.palordersoftworks.brokenstarsmp.mixins;

import org.spongepowered.asm.mixin.Mixins;

import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.util.Collection;
import java.util.Iterator;
import java.util.List;
import java.util.Map;
import java.util.Set;

public final class MixinInterceptor {

    /*
     * Any mixin targeting classes in these packages
     * will be removed before application.
     */
    private static final Set<String> PROTECTED_PACKAGES = Set.of(
            "com.palordersoftworks.brokenstarsmp"
    );

    private MixinInterceptor() {
    }

    public static void run() {
        try {
            Object transformer = getTransformer();

            if (transformer == null) {
                System.out.println("[BrokenStarSMP] Failed to locate Mixin transformer.");
                return;
            }

            Collection<?> configs = getConfigs(transformer);

            for (Object configWrapper : configs) {
                processConfig(configWrapper);
            }

        } catch (Throwable t) {
            System.out.println("[BrokenStarSMP] Mixin interceptor crashed.");
            t.printStackTrace();
        }
    }

    private static void processConfig(Object configWrapper) {
        try {
            Object config = invoke(configWrapper, "get");

            if (config == null) {
                config = getField(configWrapper, "config");
            }

            if (config == null) {
                return;
            }

            String configName = String.valueOf(invoke(configWrapper, "getName"));

            /*
             * Never touch our own config
             */
            if (configName.contains("brokenstarsmp")) {
                return;
            }

            removeMixins(config);

        } catch (Throwable t) {
            t.printStackTrace();
        }
    }

    @SuppressWarnings("unchecked")
    private static void removeMixins(Object config) {
        for (String fieldName : new String[]{"mixins", "pendingMixins"}) {

            List<Object> mixins = (List<Object>) getField(config, fieldName);

            if (mixins == null || mixins.isEmpty()) {
                continue;
            }

            Iterator<Object> iterator = mixins.iterator();

            while (iterator.hasNext()) {
                Object mixinInfo = iterator.next();

                if (targetsProtectedClass(mixinInfo)) {

                    String mixinClass =
                            String.valueOf(invoke(mixinInfo, "getClassName"));

                    System.out.println(
                            "[BrokenStarSMP] Blocked mixin: " + mixinClass
                    );

                    iterator.remove();
                }
            }
        }

        /*
         * Also clear target mappings
         */
        Map<?, ?> mapping = (Map<?, ?>) getField(config, "mixinMapping");

        if (mapping != null) {
            for (Object value : mapping.values()) {

                if (!(value instanceof List<?> list)) {
                    continue;
                }

                Iterator<?> iterator = list.iterator();

                while (iterator.hasNext()) {
                    Object mixinInfo = iterator.next();

                    if (targetsProtectedClass(mixinInfo)) {
                        iterator.remove();
                    }
                }
            }
        }
    }

    @SuppressWarnings("unchecked")
    private static boolean targetsProtectedClass(Object mixinInfo) {
        try {
            Object targetsObj = invoke(mixinInfo, "getTargetClasses");

            if (!(targetsObj instanceof Collection<?> targets)) {
                return false;
            }

            for (Object targetObj : targets) {

                String target = String.valueOf(targetObj);

                for (String protectedPackage : PROTECTED_PACKAGES) {

                    if (target.startsWith(protectedPackage)) {
                        return true;
                    }
                }
            }

        } catch (Throwable ignored) {
        }

        return false;
    }

    /*
     * =========================
     * Reflection Helpers
     * =========================
     */

    private static Object getTransformer() {
        try {
            Class<?> mixinsClass = Class.forName(
                    "org.spongepowered.asm.mixin.Mixins"
            );

            Field transformerField =
                    mixinsClass.getDeclaredField("transformer");

            transformerField.setAccessible(true);

            return transformerField.get(null);

        } catch (Throwable ignored) {
        }

        return null;
    }

    @SuppressWarnings("unchecked")
    private static Collection<?> getConfigs(Object transformer) {
        try {
            Method method =
                    transformer.getClass().getDeclaredMethod("getConfigs");

            method.setAccessible(true);

            return (Collection<?>) method.invoke(transformer);

        } catch (Throwable ignored) {
        }

        return List.of();
    }

    private static Object getField(Object instance, String fieldName) {
        try {
            Class<?> clazz = instance.getClass();

            while (clazz != null) {

                try {
                    Field field = clazz.getDeclaredField(fieldName);

                    field.setAccessible(true);

                    return field.get(instance);

                } catch (NoSuchFieldException ignored) {
                    clazz = clazz.getSuperclass();
                }
            }

        } catch (Throwable ignored) {
        }

        return null;
    }

    private static Object invoke(Object instance, String methodName) {
        try {
            Class<?> clazz = instance.getClass();

            while (clazz != null) {

                try {
                    Method method = clazz.getDeclaredMethod(methodName);

                    method.setAccessible(true);

                    return method.invoke(instance);

                } catch (NoSuchMethodException ignored) {
                    clazz = clazz.getSuperclass();
                }
            }

        } catch (Throwable ignored) {
        }

        return null;
    }
}
